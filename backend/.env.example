# ============================================================
# AYUSH CREATION BACKEND — ENVIRONMENT VARIABLES CONFIGURATION
# ============================================================

# Server Port & Mode
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection URI
# Example: mongodb+srv://admin:StrongPassword123@cluster0.abcde.mongodb.net/ayush_creation?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/ayush_creation

# JWT Authentication Secrets (Generate secure random 32+ char strings)
JWT_ACCESS_SECRET=ayush_creation_jwt_access_secret_key_2026_production_change_me
JWT_REFRESH_SECRET=ayush_creation_jwt_refresh_secret_key_2026_production_change_me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Allowed Frontend Origins for CORS (Comma-separated for multiple origins)
FRONTEND_URL=https://ayush-creation.vercel.app,http://localhost:5000,http://127.0.0.1:5500

# Cloudinary Storage Credentials (for Product & Gallery image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional Email Alerts via Nodemailer (leave blank to disable email notifications)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM="Ayush Creation Notifications <ayushcreation01@gmail.com>"
EMAIL_TO=ayushcreation01@gmail.com
